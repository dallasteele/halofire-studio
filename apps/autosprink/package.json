{
  "name": "halofire-platform",
  "version": "1.0.0",
  "description": "HaloFire - End-to-end fire sprinkler protection management platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "nodemon --experimental-specifier-resolution=node src/api/server.js",
    "dev:ui": "vite --config vite.config.js",
    "build": "vite build",
    "build:parts": "node scripts/build-parts.mjs",
    "build:1881-structure": "node scripts/build-1881-source-structure.mjs",
    "build:1881-roof-framing": "node scripts/build-1881-roof-framing-placement.mjs",
    "build:1881-source-evidence-discovery": "node scripts/build-1881-source-evidence-discovery.mjs",
    "build:1881-issued-structural-dwg-geometry": "node scripts/extract-cooperative-1881-issued-structural-dwg-geometry.mjs",
    "build:1881-issued-roof-datum-consensus": "node scripts/extract-cooperative-1881-issued-roof-datum-consensus.mjs",
    "build:1881-roof-slope-registration": "node scripts/extract-cooperative-1881-roof-slope-registration.mjs",
    "build:1881-a121-roof-face-boundaries": "node scripts/extract-cooperative-1881-a121-roof-face-boundaries.mjs",
    "build:1881-a121-slope-boundary-association": "node scripts/extract-cooperative-1881-a121-slope-boundary-association.mjs",
    "build:1881-a121-section-cut-coverage": "node scripts/extract-cooperative-1881-a121-section-cut-coverage.mjs",
    "build:1881-a307-c1-view-binding": "node scripts/extract-cooperative-1881-a307-c1-view-binding.mjs",
    "build:1881-a307-c1-profile-datum-contact": "node scripts/extract-cooperative-1881-a307-c1-profile-datum-contact.mjs",
    "build:mit-riverside-building-j-approved-pipe-layout-proof": "py -3.12 scripts/build-mit-riverside-building-j-approved-pipe-layout-proof.py",
    "build:mit-riverside-building-j-head-registered-pipe-centerlines": "py -3.12 scripts/build-mit-riverside-building-j-head-registered-pipe-centerlines.py",
    "build:mit-riverside-building-j-fp2-riser-reference": "py -3.12 scripts/build-mit-riverside-building-j-fp2-riser-reference-proof.py",
    "build:1881-roof-framing-clearance-preflight": "node scripts/build-1881-roof-framing-clearance-preflight.mjs",
    "audit:new-hope-support-cad": "node scripts/audit-new-hope-support-cad-corpus.mjs",
    "audit:victaulic-ab2-cad": "node scripts/audit-victaulic-ab2-dxf.mjs",
    "auto-source": "node scripts/auto-source-run.mjs",
    "sam31:bridge": "node scripts/sam31-bridge.mjs",
    "smoke:sam31-workbench": "node scripts/smoke-sam31-workbench.mjs",
    "smoke:public-readonly-evidence": "node scripts/smoke-public-readonly-evidence.mjs",
    "start": "node src/api/server.js",
    "cron": "node src/cron/scheduler.js",
    "test:node": "node --test tests/fitting-orient.test.js tests/prep-resync.test.js tests/real-sprinkler-head.test.js tests/reducer-position.test.js tests/scale-audit.test.js tests/sel-bracket.test.js tests/threaded-nipple.test.js tests/toolbar-modal.test.js tests/typography-shell.test.js",
    "skill:list": "node src/core/skill-runner.js --list",
    "skill:run": "node src/core/skill-runner.js --run",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "imapflow": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.10",
    "opengeometry": "^2.0.10",
    "pdfjs-dist": "^6.0.227",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mlightcad/libredwg-web": "^0.7.7",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.400.0",
    "nodemon": "^3.1.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.12.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.168.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
