node_modules/
dist/
*.log
.vite/

# Licensed manufacturer CAD (T54 import lane) — NOT for redistribution.
# The incoming drop folders and the staged STEP binaries are gitignored; the
# committed manifest (public/parts/manufacturer-step.json) references them by
# url + sha256. The dev/build server still serves the local files for the demo.
public/parts/manufacturer-incoming/
public/parts/manufacturer-step/*.stp
public/parts/manufacturer-step/*.step
public/parts/manufacturer-step/*.STP
public/parts/manufacturer-step/*.STEP

# sql.js WASM staged by build-parts-db.mjs from node_modules — a generated artifact,
# not source. The built app loads its own copy via the Vite `?url` import; this file
# is regenerated by `npm run build:parts-db`.
public/parts/sql-wasm.wasm

# parts.db is COMMITTED on purpose: it is the parts source-of-truth and holds ONLY
# metadata + URLs + sha256 hashes (NOT the licensed .stp bytes, which stay
# gitignored above). Rebuild deterministically with `npm run build:parts-db`.
# (left intentionally un-ignored)
