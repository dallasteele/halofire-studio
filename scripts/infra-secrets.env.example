# infra-secrets.env — UNATTENDED Cloudflare + Hostinger access for Claude + OpenClaw.
#
# Copy to a SECRET location that is NEVER committed:
#   GX10 (OpenClaw + cron):  /opt/hal9000/config/infra-secrets.env   (chmod 600)
#   local/VPS:               source it before running scripts/cf-dns.sh
#
# YOU create each token (minimal scope) and paste it here. The AI never handles
# the raw value — code reads these env vars; this example file holds NO secrets.

# Cloudflare — scope: Zone:Read + DNS:Edit, limited to the rankempire.io zone ONLY.
# Create at: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token ->
#   "Edit zone DNS" template -> Zone Resources: Include -> Specific zone -> rankempire.io
CLOUDFLARE_API_TOKEN=

# Hostinger — scope: VPS + DNS as needed (NOT full account if avoidable).
# Create at: hpanel.hostinger.com -> account API / VPS API tokens.
HOSTINGER_API_TOKEN=
